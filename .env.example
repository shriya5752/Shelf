# Copy this file to .env.local and fill it in. Never commit .env.local.

# Supabase: Project Settings > API
# (the anon key is designed to be public. NEVER put the service_role key here.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TMDB: themoviedb.org > Settings > API (free). Server-side only, not exposed to the browser.
# Without it, search only covers a small built-in list of popular titles.
TMDB_API_KEY=

# Whose shelf visitors see on the home page (their username). Leave empty to show a sample shelf instead.
NEXT_PUBLIC_FEATURED_USERNAME=

# Set when deployed (link previews + privacy page)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
